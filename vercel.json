{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "digest.veraops.com"
        }
      ],
      "destination": "https://veraops.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.veraops.com"
        }
      ],
      "destination": "https://veraops.com/$1",
      "permanent": true
    },
    {
      "source": "/markdepace",
      "destination": "/mark-depace",
      "permanent": true
    },
    {
      "source": "/Mark-DePace",
      "destination": "/mark-depace",
      "permanent": true
    },
    {
      "source": "/MarkDePace",
      "destination": "/mark-depace",
      "permanent": true
    },
    {
      "source": "/frank-siringo",
      "destination": "/team-bubbly",
      "permanent": true
    },
    {
      "source": "/Frank-Siringo",
      "destination": "/team-bubbly",
      "permanent": true
    },
    {
      "source": "/TeamBubbly",
      "destination": "/team-bubbly",
      "permanent": true
    },
    {
      "source": "/Team-Bubbly",
      "destination": "/team-bubbly",
      "permanent": true
    },
    {
      "source": "/teambubbly",
      "destination": "/team-bubbly",
      "permanent": true
    },
    {
      "source": "/Sharon-Toerek",
      "destination": "/sharon-toerek",
      "permanent": true
    },
    {
      "source": "/sharontoerek",
      "destination": "/sharon-toerek",
      "permanent": true
    },
    {
      "source": "/toerek-law",
      "destination": "/sharon-toerek",
      "permanent": true
    },
    {
      "source": "/toereklaw",
      "destination": "/sharon-toerek",
      "permanent": true
    },
    {
      "source": "/Drew-McLellan",
      "destination": "/drew-mclellan",
      "permanent": true
    },
    {
      "source": "/drewmclellan",
      "destination": "/drew-mclellan",
      "permanent": true
    },
    {
      "source": "/ami",
      "destination": "/drew-mclellan",
      "permanent": true
    },
    {
      "source": "/AMI",
      "destination": "/drew-mclellan",
      "permanent": true
    },
    {
      "source": "/agency-management-institute",
      "destination": "/drew-mclellan",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(the-bureau|agencyhabits|agency-outsight|surge|team-bubbly|mark-depace|sharon-toerek|drew-mclellan)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
